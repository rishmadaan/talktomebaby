{
  "name": "talktomebaby-cli",
  "version": "0.2.0",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "talktomebaby": "dist/cli.js"
  },
  "files": [
    "dist", "LICENSE", "LICENSING.md", "THIRD_PARTY_NOTICES.md", "source.tar.gz"
  ],
  "scripts": {
    "prebuild": "npm -C ../.. run build -w @talktomebaby/engine",
    "build": "esbuild src/cli.ts --bundle --outfile=dist/cli.js --platform=node --format=cjs --banner:js=\"#!/usr/bin/env node\"",
    "prepack": "npm run build && node ../../scripts/stage-package-docs.js cli",
    "pretest": "npm -C ../.. run build -w @talktomebaby/engine",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "devDependencies": {
    "@talktomebaby/engine": "*",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.0",
    "vitest": "^3.0.0"
  }
}
